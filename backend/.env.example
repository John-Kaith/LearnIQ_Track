# Supabase (required)
SUPABASE_URL=
SUPABASE_KEY=

# Gmail SMTP — sends LRN/email + auto-generated password after registration
# Use a Google App Password: https://myaccount.google.com/apppasswords
# SMTP_FROM should match SMTP_USER (Gmail rewrites From to the login account otherwise).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-school@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your-school@gmail.com
APP_LOGIN_URL=http://127.0.0.1:8000/login.html
